# Get your Privy App ID from https://dashboard.privy.io
# The game works without it (standalone mode) but wallet features won't be available
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id-here

# Solana RPC URL (defaults to devnet if not set)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Upstash Redis (required for shared leaderboard)
# Create via Vercel Dashboard → Storage → Upstash, then connect to your project
# These env vars are automatically added when you link the database
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
